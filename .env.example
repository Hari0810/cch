# ---- Supabase ----
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser / never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Anthropic (risk assessment layer) ----
ANTHROPIC_API_KEY=
# Exact model string, no date suffix.
ANTHROPIC_MODEL=claude-opus-5

# ---- Modal (embeddings / behavioural baseline / attack-graph) ----
# `modal token new` writes these to ~/.modal.toml; set here only if you need
# them in-process (e.g. calling a deployed Modal function from a route handler).
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Public URL of the deployed Modal web endpoint the app calls.
MODAL_SCORING_ENDPOINT=
